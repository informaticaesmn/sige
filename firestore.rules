// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth.token['roles'] != null && request.auth.token['roles'].hasAny(['admin']);
    }

    function esBedel() {
      return request.auth.token['roles'] != null && request.auth.token['roles'].hasAny(['bedel']);
    }

    function esCoordinacion() {
      return request.auth.token['roles'] != null && request.auth.token['roles'].hasAny(['coordinacion']);
    }

    // --- Usuarios ---
    match /usuarios/{userId} {
      // Lectura: el propio usuario, o los roles de gestión (bedel/coordinacion/admin).
      allow read: if request.auth.uid == userId || esBedel() || esCoordinacion() || esAdmin();

      // Alta (incluye la carga masiva por CSV de coordinación):
      // - admin puede crear cualquier usuario.
      // - coordinacion puede dar de alta estudiantes, docentes y bedeles, pero
      //   NUNCA crear un 'admin' ni otro 'coordinacion' (evita el auto-ascenso
      //   creando un documento nuevo). Solo admin otorga roles privilegiados.
      allow create: if esAdmin() ||
                    (esCoordinacion() &&
                     !request.resource.data.roles.hasAny(['admin', 'coordinacion']));

      // Update: el array `roles` queda congelado para todos salvo admin.
      // (a) el dueño edita sus datos sin tocar roles
      // (b) bedel/coordinacion editan campos no-roles de estudiantes
      // (c) admin sin restricciones: único rol que puede ascender/degradar
      allow update: if (request.auth.uid == userId && request.resource.data.roles == resource.data.roles) ||
                    ((esBedel() || esCoordinacion()) &&
                     resource.data.roles.hasAny(['estudiante']) &&
                     request.resource.data.roles == resource.data.roles) ||
                    esAdmin();

      // Borrar usuarios es tarea exclusiva de admin.
      allow delete: if esAdmin();
    }

    // --- Oferta Académica ---
    // Documento único por ciclo (`ofertaAcademica/{ciclo}`, ver useOfertaAcademica.js).
    // Lectura para cualquier autenticado; escritura para coordinacion y admin.
    // `write` incluye create + update + delete: coordinación puede "limpiar" un
    // ciclo completo (la carga reemplaza el documento entero, ver useCargaOferta.js).
    match /ofertaAcademica/{ciclo} {
      allow read: if request.auth != null;
      allow write: if esCoordinacion() || esAdmin();
    }

    // --- Inscripciones de un usuario (subcolección por ciclo) ---
    // La subcolección se llama `inscripciones` + ciclo sin guiones:
    //   ciclo "2026-1" -> usuarios/{uid}/inscripciones20261/{materiaId}
    //   (ver src/composables/inscripciones/useInscripciones.js)
    //
    // OJO: NO se puede usar un comodín parcial tipo `inscripciones{ciclo}` porque las
    // reglas de Firestore solo soportan comodines de segmento completo (`{id}`) o
    // recursivos (`{id=**}`). Por eso se captura el segmento entero y se valida con
    // matches().
    match /usuarios/{userId}/{subcoleccion}/{materiaId} {
      function esInscripcion() {
        return subcoleccion.matches('^inscripciones[0-9]+$');
      }

      // Cada estudiante ve lo suyo; bedel y admin ven todo.
      allow read: if esInscripcion() && (request.auth.uid == userId || esBedel() || esAdmin());

      // El estudiante crea su inscripción, siempre en estado 'pendiente'.
      allow create: if esInscripcion() && request.auth.uid == userId &&
                    request.resource.data.estado == 'pendiente';

      // El estudiante puede modificar su inscripción (ej. cambiar de comisión) pero
      // NUNCA el estado: no puede auto-confirmarse.
      // Bedel/admin sí pueden confirmar, pero solo tocando el campo `estado`.
      allow update: if esInscripcion() &&
        ((request.auth.uid == userId &&
          request.resource.data.estado == resource.data.estado) ||
         ((esBedel() || esAdmin()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])));

      // Borrar inscripciones es tarea de bedel/admin.
      allow delete: if esInscripcion() && (esBedel() || esAdmin());
    }
  }
}