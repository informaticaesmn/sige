{
  "name": "sige",
  "private": true,
  "version": "0.7.24",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-sige \"vitest run --config vitest.integration.config.js\"",
